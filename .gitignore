# ---- 临时 / 调试文件 ----
# 开发时用来做验证的临时页面与脚本（以 _ 开头），不入库
_*
!/.gitignore

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
*.swp
*~
Thumbs.db
Desktop.ini
.DS_Store

# ---- 依赖 / 构建产物（本项目零依赖，留着备用）----
node_modules/
dist/
build/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# ---- 本地私有配置（密钥在这里，绝对不要提交）----
config.local.js

# ---- 本地环境变量（部署时密钥走云平台的环境变量，不要传文件）----
.env
.env.local
.env.*.local
*.pem
*.key

# ---- OSS 配置（含 AccessKey，绝不能提交）----
config.oss.local.py
# ---- 速创 API 密钥 ----
config.wuyinkeji.local.py

# ---- Python ----
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ---- 打包产物（build_deploy.py 生成，不该入库）----
www/
deploy/
*.zip

# ---- 编辑时的备份 ----
*.bak
*.orig

# ---- 本地预览产物（可选：不想把截图传上去就把下面几行取消注释）----
# preview-*.png
